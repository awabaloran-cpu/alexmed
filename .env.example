# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────
# Postgres connection string (e.g. Supabase pooler URL)
DATABASE_URL=

# ── Queue (Upstash QStash) ────────────────────────────
# Get these from https://console.upstash.com/qstash
# QSTASH_URL is optional (defaults to the global endpoint) — set it to your
# region's endpoint (e.g. https://qstash-eu-central-1.upstash.io) if shown
# on the console, for lower publish latency.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Publicly reachable base URL QStash delivers worker callbacks to (a Vercel
# deployment URL, or a tunnel like ngrok for local dev — QStash cannot reach
# http://localhost directly).
APP_BASE_URL=http://localhost:3000
# Max delivery attempts per batch/chapter (1 initial + retries) before it's
# marked "failed" and surfaced to the student for a manual retry.
QUEUE_MAX_ATTEMPTS=4
# QStash Flow Control parallelism caps — global across all students, and per
# student, so one student's file can't starve everyone else's queue.
QUEUE_GLOBAL_CONCURRENCY=5
QUEUE_PER_USER_CONCURRENCY=2
# How many مِرآة/كتبي jobs one user may create within the time window below.
JOB_CREATION_RATE_LIMIT_MAX=5
JOB_CREATION_RATE_LIMIT_WINDOW_MINUTES=10
# How many اسألني (chatRouter.ask) messages one user may send within the
# window below — each one is a real LLM call.
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_MINUTES=10

# ── Auth ──────────────────────────────────────────────
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# How many failed Credentials sign-in attempts one email may accumulate
# within the window below before login is temporarily blocked for it.
LOGIN_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Optional: set both to enable "Sign in with Google" on /login and /register.
# https://console.cloud.google.com/apis/credentials — Authorized redirect URI:
# <your-deployed-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone sign-up: SMS verification codes via Vonage Verify v2 (lib/sms/vonage.ts).
# Required for creating accounts — without them sign-up shows "not available".
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Optional: name shown in the SMS (default NiroLearn) and its language (default ar-xa).
VONAGE_BRAND=NiroLearn
VONAGE_LOCALE=ar-xa
# Where the code is sent, in order. "whatsapp,sms" = WhatsApp first, an SMS
# only if the code was not entered within VONAGE_CHANNEL_TIMEOUT_SECONDS
# (so the SMS is paid for only when WhatsApp did not do the job). Unset or
# "sms" = SMS only. WhatsApp must be enabled for Verify on the Vonage
# account; if Vonage refuses the WhatsApp workflow the code is sent by SMS
# alone and the refusal is logged.
VONAGE_VERIFY_CHANNELS=sms
VONAGE_CHANNEL_TIMEOUT_SECONDS=90
# Optional: the account's own WhatsApp Business number (digits). Without it
# Vonage sends from its shared sender.
VONAGE_WHATSAPP_FROM=
# Needed with your own WhatsApp number: the number is linked to a Vonage
# APPLICATION, and Vonage only honours it on requests signed with that
# application's key. Set both and every Verify call uses the application
# (JWT) instead of the API key/secret. The private key is the PEM file from
# the application's page (one line with \n for line breaks is fine).
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY=
# A third, free way to verify the number needs no setting of its own: with
# the Telegram gateway on (TELEGRAM_ENABLED + TELEGRAM_BOT_USERNAME below),
# /register offers "verify through Telegram" — the student shares their
# number with the bot instead of receiving a code.

# ── Object storage (S3-compatible) ───────────────────
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── AI Gateway ────────────────────────────────────────
# LLM_PROVIDER selects which one lib/ai/gateway.ts routes through:
#   omniroute  — default once OMNIROUTE_API_KEY is set below
#   openrouter — the original provider, kept fully working as a fallback
# Leave unset to auto-pick (omniroute if its key is present, else openrouter).
LLM_PROVIDER=

# OmniRoute: self-hosted OpenAI-compatible AI gateway (Railway).
OMNIROUTE_BASE_URL=https://omniroute-noodeenv.up.railway.app/v1
OMNIROUTE_API_KEY=
# OmniRoute owns model selection — never client-selectable. This should stay
# one of OmniRoute's own "auto/*" routing aliases (it still picks the real
# underlying model per request); if unset, the app falls back to asking
# OmniRoute's GET /v1/models for a model id at request time.
OMNIROUTE_DEFAULT_MODEL=auto/best-free
# Comma-separated models tried in order when the default fails (text).
OMNIROUTE_FALLBACK_MODELS=
# Requests that carry an IMAGE (OCR of scanned pages, page-visual analysis,
# question images) use this chain instead — many strong text models can't
# read images at all. Leave both empty to keep images on the text chain.
# e.g. OMNIROUTE_VISION_MODEL=nvidia/meta/llama-3.2-11b-vision-instruct
#      OMNIROUTE_VISION_FALLBACK_MODELS=nvidia/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,gemini/gemini-2.5-flash
OMNIROUTE_VISION_MODEL=
OMNIROUTE_VISION_FALLBACK_MODELS=

# How many background generations ONE server process sends to the gateway at
# once (lib/ai/gate.ts); the rest wait their turn. Per process: two replicas
# send up to twice this. Lower it if the gateway answers
# "503 chat_admission_busy"; raise it when the gateway has room. Default 6.
AI_MAX_CONCURRENT=

# OpenRouter — supports any model, many free. Get a key at
# https://openrouter.ai/keys. Model is chosen per-request (the UI lets the
# user pick any listed model), so no default model env var is needed here.
OPENROUTER_API_KEY=

# ── Upload limits ─────────────────────────────────────
UPLOAD_MAX_MB=250

# ── Telegram gateway (lib/telegram) — see docs/telegram/TELEGRAM_GATEWAY.md ──
# Off unless TELEGRAM_ENABLED=true AND the token and secret are set; while
# off the webhook answers 404 and nothing else in the app changes.
TELEGRAM_ENABLED=false
# From @BotFather. Never commit it; rotate it if it is ever pasted anywhere.
TELEGRAM_BOT_TOKEN=
# The bot's @username without the @ (builds t.me links on /account).
TELEGRAM_BOT_USERNAME=
# A long random string you choose; given to Telegram in setWebhook and sent
# back on every call (X-Telegram-Bot-Api-Secret-Token). 1-256 chars, A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=
# Largest PDF the bot accepts. Telegram's own Bot API never gives a bot a
# file above 20 MB, so anything higher only takes effect with a self-hosted
# Bot API server set in TELEGRAM_API_BASE (e.g. http://telegram-bot-api:8081).
TELEGRAM_MAX_FILE_MB=70
TELEGRAM_API_BASE=
# Longest PDF the bot accepts, in pages (longer files are refused with a
# message asking the student to split them).
TELEGRAM_MAX_PAGES=100
# 📝 PDF summaries (lib/summary): registered accounts only. The free plan
# gets SUMMARY_FREE_DAILY a day from files of at most SUMMARY_FREE_MAX_PAGES
# pages; any paid plan gets the PAID values.
SUMMARY_FREE_DAILY=1
SUMMARY_FREE_MAX_PAGES=40
SUMMARY_PAID_DAILY=10
SUMMARY_PAID_MAX_PAGES=150
# Leave empty on the server (the bundled Chromium is used). On a developer's
# machine, the path of an installed Chrome.
CHROMIUM_PATH=
# Files a guest may send before being asked to create their account.
TELEGRAM_GUEST_FREE_UPLOADS=1
# Abuse ceilings: per Telegram account per 10 minutes, and every Telegram
# upload from everyone per 24 hours.
TELEGRAM_ACCOUNT_BURST_LIMIT=5
TELEGRAM_DAILY_UPLOAD_CAP=300
# How long a guest's "open NiroLearn" link stays valid (minutes).
TELEGRAM_LINK_TTL_MINUTES=1440
# Files copied from Telegram into storage at once (each is held in memory).
TELEGRAM_INTAKE_CONCURRENCY=2
# Bot buttons open NiroLearn inside Telegram as a Mini App (/tg), signing
# the student in from Telegram's signed launch data. Set to false to make
# them ordinary browser links instead.
TELEGRAM_MINI_APP=true
# "Send to classmates" opens the chat picker and posts a card with a button.
# Needs inline mode switched on for the bot in BotFather (/setinline) first;
# Telegram refuses the button otherwise.
TELEGRAM_INLINE_SHARE=false

# ── Ads (lib/ads) ─────────────────────────────────────
# Off unless ADS_ENABLED=true. Only free plans ever see an ad break.
ADS_ENABLED=false
# "all": every free student's questions, flashcards and Exam Focus cards.
# "telegram": only files that arrived through the bot.
ADS_SCOPE=all
ADS_QUESTIONS_PER_BREAK=10
# Google AdSense publisher id (ca-pub-…) and the display ad unit's slot id.
# Leave the slot empty to fill the break with NiroLearn's own card instead.
# Setting the publisher id also publishes /ads.txt and the
# google-adsense-account meta tag (AdSense's site ownership check).
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_QUESTION_BREAK=
# AdsGram (Telegram's Mini App ad network) block id, a number — from
# partner.adsgram.ai → the ad unit → "Copy BlockID". With it set, a break
# INSIDE Telegram is a rewarded ad that must be watched to reach the next
# questions; outside Telegram the break stays as above. The platform's
# "Web app url" at AdsGram must be this site's origin, and the block must be
# of type Reward and active.
ADSGRAM_BLOCK_ID=
