# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────
# Postgres connection string (e.g. Supabase pooler URL)
DATABASE_URL=

# ── Queue (Upstash QStash) ────────────────────────────
# Get these from https://console.upstash.com/qstash
# QSTASH_URL is optional (defaults to the global endpoint) — set it to your
# region's endpoint (e.g. https://qstash-eu-central-1.upstash.io) if shown
# on the console, for lower publish latency.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Publicly reachable base URL QStash delivers worker callbacks to (a Vercel
# deployment URL, or a tunnel like ngrok for local dev — QStash cannot reach
# http://localhost directly).
APP_BASE_URL=http://localhost:3000
# Max delivery attempts per batch/chapter (1 initial + retries) before it's
# marked "failed" and surfaced to the student for a manual retry.
QUEUE_MAX_ATTEMPTS=4
# QStash Flow Control parallelism caps — global across all students, and per
# student, so one student's file can't starve everyone else's queue.
QUEUE_GLOBAL_CONCURRENCY=5
QUEUE_PER_USER_CONCURRENCY=2
# How many مِرآة/كتبي jobs one user may create within the time window below.
JOB_CREATION_RATE_LIMIT_MAX=5
JOB_CREATION_RATE_LIMIT_WINDOW_MINUTES=10
# How many اسألني (chatRouter.ask) messages one user may send within the
# window below — each one is a real LLM call.
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_MINUTES=10

# ── Auth ──────────────────────────────────────────────
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# How many failed Credentials sign-in attempts one email may accumulate
# within the window below before login is temporarily blocked for it.
LOGIN_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Optional: set both to enable "Sign in with Google" on /login and /register.
# https://console.cloud.google.com/apis/credentials — Authorized redirect URI:
# <your-deployed-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone sign-up: SMS verification codes via Vonage Verify v2 (lib/sms/vonage.ts).
# Required for creating accounts — without them sign-up shows "not available".
VONAGE_API_KEY=
VONAGE_API_SECRET=
# Optional: name shown in the SMS (default NiroLearn) and its language (default ar-xa).
VONAGE_BRAND=NiroLearn
VONAGE_LOCALE=ar-xa

# ── Object storage (S3-compatible) ───────────────────
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── AI Gateway ────────────────────────────────────────
# LLM_PROVIDER selects which one lib/ai/gateway.ts routes through:
#   omniroute  — default once OMNIROUTE_API_KEY is set below
#   openrouter — the original provider, kept fully working as a fallback
# Leave unset to auto-pick (omniroute if its key is present, else openrouter).
LLM_PROVIDER=

# OmniRoute: self-hosted OpenAI-compatible AI gateway (Railway).
OMNIROUTE_BASE_URL=https://omniroute-noodeenv.up.railway.app/v1
OMNIROUTE_API_KEY=
# OmniRoute owns model selection — never client-selectable. This should stay
# one of OmniRoute's own "auto/*" routing aliases (it still picks the real
# underlying model per request); if unset, the app falls back to asking
# OmniRoute's GET /v1/models for a model id at request time.
OMNIROUTE_DEFAULT_MODEL=auto/best-free
# Comma-separated models tried in order when the default fails (text).
OMNIROUTE_FALLBACK_MODELS=
# Requests that carry an IMAGE (OCR of scanned pages, page-visual analysis,
# question images) use this chain instead — many strong text models can't
# read images at all. Leave both empty to keep images on the text chain.
# e.g. OMNIROUTE_VISION_MODEL=nvidia/meta/llama-3.2-11b-vision-instruct
#      OMNIROUTE_VISION_FALLBACK_MODELS=nvidia/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,gemini/gemini-2.5-flash
OMNIROUTE_VISION_MODEL=
OMNIROUTE_VISION_FALLBACK_MODELS=

# OpenRouter — supports any model, many free. Get a key at
# https://openrouter.ai/keys. Model is chosen per-request (the UI lets the
# user pick any listed model), so no default model env var is needed here.
OPENROUTER_API_KEY=

# ── Upload limits ─────────────────────────────────────
UPLOAD_MAX_MB=250
